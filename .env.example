# Database: PostgreSQL connection URL (Neon, Supabase, Railway, RDS, etc.)
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:5432/safedeal?sslmode=require"

# Auth: 32+ character random secret for signing HttpOnly cookies
SESSION_SECRET="your-secure-random-32-byte-secret-here"

# Domain: Canonical public URL of your deployed site
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Stripe (Optional - app runs simulated escrow rails if keys are absent)
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

